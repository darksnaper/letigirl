    "framer-motion": "^13.2.0",
    "lucide-react": "^1.45.0",
    "next": "14.2.15",
    "prisma": "^5.22.0",
    "react": "^18",
    "react-dom": "^18",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.15",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
